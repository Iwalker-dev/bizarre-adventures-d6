<div class="gambit-selection-dialog">
    <label>Choose a Gambit:</label>
    {{#each gambitsByActor}}
        <h4>{{actor.name}}</h4>
        <div class="gambit-options">
            {{#each actor.items}}
                <button class="gambit-option" 
                    type="button" 
                    data-item="{{this.id}}"
                    data-source-uuid="{{../sourceUuid}}"
                    data-actor-id="{{../actorId}}">
                    {{value.name}}
                </button>
            {{/each}}
        </div>
    {{/each}}
</div>